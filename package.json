{
  "name": "tvman-unknown-yapyur",
  "productName": "YapYur",
  "version": "1.33.5",
  "description": "YapYur Windows desktop client with plugin, theme and settings support",
  "main": "src/main/index.js",
  "author": "Tvmanisback",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "npx --yes electron-builder --win portable",
    "dist:linux": "npx --yes electron-builder --linux AppImage",
    "dist:installer": "node tools/build-installer.js",
    "dist:extension": "node tools/build-extension.js --zip",
    "dist:bookmarklet": "node tools/build-bookmarklet.js",
    "test": "node test/run-all.js",
    "test:unit": "node test/unit.js"
  },
  "devDependencies": {
    "electron": "^38.0.0"
  },
  "build": {
    "appId": "tvman.unknown.yapyur",
    "productName": "YapYur",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "themes/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "YapYur-${version}-portable.exe"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "artifactName": "YapYur-${version}.AppImage"
    }
  },
  "yapyur": {
    "updateRepo": "Tvmanisback/YapYur-Windows"
  },
  "appId": "tvman.unknown.yapyur"
}
